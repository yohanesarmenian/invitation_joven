{
  "name": "wedding-invitation",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "pnpm db:generate && turbo run build",
    "lint": "turbo run lint",
    "typecheck": "pnpm db:generate && turbo run typecheck",
    "test": "pnpm db:generate && turbo run test",
    "test:e2e": "playwright test --config=apps/invitation-web/playwright.config.ts",
    "test:e2e:real": "pnpm --filter api build && playwright test --config=apps/invitation-web/playwright.real.config.ts",
    "db:generate": "pnpm --filter api db:generate",
    "db:validate": "pnpm --filter api db:validate",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:migrate:deploy": "pnpm --filter api db:migrate:deploy",
    "db:status": "pnpm --filter api db:status",
    "api:openapi": "pnpm --filter api openapi:generate",
    "api-client:generate": "pnpm --filter @wedding-invitation/api-client generate",
    "api:contract:generate": "pnpm api:openapi && pnpm api-client:generate",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "turbo": "^2.10.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
