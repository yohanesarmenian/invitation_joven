{
  "name": "wedding-invitation",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "turbo run dev",
    "local:init": "node ops/local-daily.mjs init",
    "local:up": "node ops/local-daily.mjs up",
    "local:status": "node ops/local-daily.mjs status",
    "local:down": "node ops/local-daily.mjs down",
    "local:recover": "node ops/local-daily.mjs recover",
    "local:owner": "node ops/local-daily.mjs owner",
    "local:catalog": "node ops/local-daily.mjs catalog",
    "local:generate": "node ops/local-daily.mjs generate",
    "local:test": "node --test ops/daily/*.test.mjs",
    "local:lint": "eslint --config ops/daily/eslint.config.mjs ops/local-daily.mjs ops/daily",
    "local:build": "node ops/daily/build.mjs",
    "local:verify": "node ops/daily/verify.mjs",
    "local:verify:gaps": "node ops/daily/verify.mjs --gaps",
    "local:verify:events": "node ops/daily/verify.mjs --events",
    "local:backup": "node ops/local-daily.mjs backup",
    "local:backup:list": "node ops/local-daily.mjs backup-list",
    "local:backup:verify": "node ops/local-daily.mjs backup-verify",
    "local:restore": "node ops/local-daily.mjs restore",
    "local:restore:remove": "node ops/local-daily.mjs restore-remove",
    "local:verify:backups": "node ops/daily/verify.mjs --backups",
    "local:verify:lifecycle": "node ops/daily/lifecycle-verify.mjs",
    "local:verify:context": "node ops/daily/context-verify.mjs",
    "deploy:test": "node --test ops/deploy/*.test.mjs",
    "deploy:lint": "eslint --config ops/deploy/eslint.config.mjs ops/deploy",
    "deploy:containers": "node ops/deploy/container-smoke.mjs",
    "build": "pnpm db:generate && turbo run build",
    "lint": "turbo run lint",
    "typecheck": "pnpm db:generate && turbo run typecheck",
    "test": "pnpm db:generate && turbo run test",
    "test:e2e": "playwright test --config=apps/invitation-web/playwright.config.ts",
    "test:e2e:real": "pnpm --filter api build && playwright test --config=apps/invitation-web/playwright.real.config.ts",
    "db:generate": "pnpm --filter api db:generate",
    "db:validate": "pnpm --filter api db:validate",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:migrate:deploy": "pnpm --filter api db:migrate:deploy",
    "db:status": "pnpm --filter api db:status",
    "api:openapi": "pnpm --filter api openapi:generate",
    "api-client:generate": "pnpm --filter @wedding-invitation/api-client generate",
    "api:contract:generate": "pnpm api:openapi && pnpm api-client:generate",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "turbo": "^2.10.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1",
    "yaml": "2.9.1"
  }
}
