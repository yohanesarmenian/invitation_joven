DATABASE_URL="postgresql://invitation_dev:invitation_dev_password@localhost:5432/invitation_dev?schema=public"
CREDENTIAL_SECRET="<base64url-encoded-32-byte-secret>"
INVITATION_API_BASE_URL="http://localhost:4000"
# Expected browser origin for admin requests (scheme + host + optional port, no trailing path).
# Configuration, not a secret. Every unsafe admin request, including login, is validated by exact match.
ADMIN_ORIGIN="http://localhost:3001"
# Server-only admin-web API upstream (non-secret; never a browser base URL).
ADMIN_API_INTERNAL_BASE_URL="http://127.0.0.1:4000"
# Guest-facing public invitation origin (scheme + host + optional port, no path, no query).
# Configuration, not a secret. Used to build the copyable invitation link returned by the
# admin public-url and regenerate-token endpoints. Production must use https.
PUBLIC_INVITATION_BASE_URL="http://localhost:3000"
