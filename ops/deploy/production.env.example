API_IMAGE=ghcr.io/OWNER/invitation-api@sha256:REPLACE
ADMIN_WEB_IMAGE=ghcr.io/OWNER/invitation-admin-web@sha256:REPLACE
INVITATION_WEB_IMAGE=ghcr.io/OWNER/invitation-web@sha256:REPLACE
POSTGRES_IMAGE=postgres:18
POSTGRES_DB=invitation
POSTGRES_PASSWORD=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
APP_DATABASE_PASSWORD=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
MIGRATOR_DATABASE_PASSWORD=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
DATABASE_URL=postgresql://invitation_app:URL_ENCODED_APP_PASSWORD@postgres:5432/invitation?schema=public
MIGRATION_DATABASE_URL=postgresql://invitation_migrator:URL_ENCODED_MIGRATOR_PASSWORD@postgres:5432/invitation?schema=public
CREDENTIAL_SECRET=REPLACE_WITH_PERSISTENT_32_BYTE_BASE64URL_SECRET
ADMIN_ORIGIN=https://admin.example.com
PUBLIC_INVITATION_BASE_URL=https://invite.example.com
