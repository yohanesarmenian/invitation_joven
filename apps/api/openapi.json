    "/api/public/invitations/{publicCredential}": {
      "get": {
        "operationId": "PublicInvitationController_retrievePublicInvitation",
        "parameters": [
          {
            "name": "publicCredential",
            "required": true,
            "in": "path",
            "schema": {
              "maxLength": 43,
              "minLength": 43,
              "pattern": "^[A-Za-z0-9_-]{43}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicInvitationResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Invitation unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelopeDto"
                }
              }
            }
          }
        },
        "summary": "Retrieve a public invitation",
        "tags": [
          "Public Invitations"
        ]
      }
    },
    "/api/public/invitations/{publicCredential}/rsvp": {
      "get": {
        "operationId": "PublicInvitationController_retrievePublicRsvp",
        "parameters": [
          {
            "name": "publicCredential",
            "required": true,
            "in": "path",
            "schema": {
              "maxLength": 43,
              "minLength": 43,
              "pattern": "^[A-Za-z0-9_-]{43}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicRsvpReadResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Invitation unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelopeDto"
                }
              }
            }
          }
        },
        "summary": "Retrieve public RSVP state",
        "tags": [
          "Public Invitations"
        ]
      },
      "put": {
        "operationId": "PublicInvitationController_submitPublicRsvp",
        "parameters": [
          {
            "name": "publicCredential",
            "required": true,
            "in": "path",
            "schema": {
              "maxLength": 43,
              "minLength": 43,
              "pattern": "^[A-Za-z0-9_-]{43}$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitPublicRsvpRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicRsvpMutationResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request payload.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelopeDto"
                }
              }
            }
          },
          "404": {
            "description": "Invitation unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelopeDto"
                }
              }
            }
          },
          "409": {
            "description": "RSVP version conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelopeDto"
                }
              }
            }
          },
          "422": {
            "description": "RSVP domain validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelopeDto"
                }
              }
            }
          }
        },
        "summary": "Create or update public RSVP",
        "tags": [
          "Public Invitations"
        ]
      }
    },
    "/api/public/invitations/{publicCredential}/messages": {
      "post": {
        "operationId": "PublicGuestMessageController_submitPublicGuestMessage",
        "parameters": [
          {
            "name": "publicCredential",
            "required": true,
            "in": "path",
            "schema": {
              "maxLength": 43,
              "minLength": 43,
              "pattern": "^[A-Za-z0-9_-]{43}$",
