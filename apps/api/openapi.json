              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicGuestMessageResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request payload.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelopeDto"
                }
              }
            }
          },
          "404": {
            "description": "Invitation unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelopeDto"
                }
              }
            }
          }
        },
        "summary": "Submit a public guest message",
        "tags": [
          "Public Guest Messages"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "HealthController_getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "Health"
        ]
      }
    }
  },
  "info": {
    "title": "Wedding Invitation API",
    "description": "Backend API contract for the wedding invitation system.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "AdminLoginRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 15
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AdminAuthUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER"
            ]
          }
        },
        "required": [
          "id",
          "email",
          "role"
        ]
      },
      "AdminAuthSessionDto": {
        "type": "object",
        "properties": {
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "expiresAt"
        ]
      },
      "AdminAuthResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/AdminAuthUserDto"
          },
          "session": {
            "$ref": "#/components/schemas/AdminAuthSessionDto"
          },
          "csrfToken": {
            "type": "string"
          }
        },
        "required": [
          "user",
          "session",
          "csrfToken"
        ]
      },
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": true,
            "nullable": true
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ]
      },
      "ApiErrorEnvelopeDto": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiErrorDto"
          },
          "requestId": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "error",
          "requestId",
          "timestamp"
        ]
      },
      "PublicInvitationEventDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "venueName": {
            "type": "string",
            "nullable": true
          },
          "address": {
            "type": "string",
            "nullable": true
          },
          "googleMapsUrl": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "startsAt",
          "venueName",
          "address",
          "googleMapsUrl"
        ]
      },
      "PublicInvitationInviteeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "fullName": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "ADULT",
              "CHILD"
            ]
          }
        },
        "required": [
          "id",
          "fullName",
          "category"
        ]
      },
      "PublicInvitationRulesDto": {
        "type": "object",
        "properties": {
          "allowPlusOne": {
            "type": "boolean"
          },
          "maxAdditionalChildren": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "allowPlusOne",
          "maxAdditionalChildren"
        ]
      },
      "PublicInvitationRsvpDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "ACCEPTED",
              "DECLINED"
            ]
          },
          "version": {
            "type": "number",
            "minimum": 1
          }
        },
        "required": [
          "status",
          "version"
        ]
      },
      "PublicInvitationDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string"
          },
          "greetingName": {
            "type": "string",
            "nullable": true
          },
          "rsvpDeadlineAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicInvitationEventDto"
            }
          },
          "invitees": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicInvitationInviteeDto"
            }
          },
          "rules": {
            "$ref": "#/components/schemas/PublicInvitationRulesDto"
          },
          "rsvp": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/PublicInvitationRsvpDto"
              }
            ]
          }
        },
        "required": [
          "displayName",
          "greetingName",
          "rsvpDeadlineAt",
          "events",
          "invitees",
          "rules",
          "rsvp"
        ]
      },
      "PublicInvitationResponseDto": {
        "type": "object",
        "properties": {
          "invitation": {
            "$ref": "#/components/schemas/PublicInvitationDto"
          }
        },
        "required": [
          "invitation"
        ]
      },
      "PublicRsvpEventSelectionDto": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "attending": {
            "type": "boolean"
          },
          "expectedAttendeeCount": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "eventId",
          "attending",
          "expectedAttendeeCount"
        ]
      },
      "PublicRsvpAttendeeDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "NAMED_INVITEE",
              "PLUS_ONE",
              "ADDITIONAL_CHILD"
            ]
          },
          "inviteeId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "quantity": {
            "type": "number",
            "minimum": 1
          }
        },
        "required": [
          "type",
          "inviteeId",
          "quantity"
        ]
      },
      "PublicRsvpStateDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "ACCEPTED",
              "DECLINED"
            ]
          },
          "version": {
            "type": "number",
            "minimum": 1
          },
          "dietaryNotes": {
            "type": "string",
            "nullable": true
          },
          "attendeeQuantityTotal": {
            "type": "number",
            "minimum": 0
          },
          "eventSelections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicRsvpEventSelectionDto"
            }
          },
          "attendees": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicRsvpAttendeeDto"
            }
          }
        },
        "required": [
          "status",
          "version",
          "dietaryNotes",
          "attendeeQuantityTotal",
          "eventSelections",
          "attendees"
        ]
      },
      "PublicCheckinPassDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE"
            ]
          },
          "issuedAt": {
            "type": "string",
            "format": "date-time"
          },
          "qrPayload": {
            "type": "string",
            "description": "Bare opaque check-in credential payload for the guest QR.",
            "maxLength": 43,
            "minLength": 43,
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        },
        "required": [
          "status",
          "issuedAt",
          "qrPayload"
        ]
      },
      "PublicRsvpReadResponseDto": {
        "type": "object",
        "properties": {
          "rsvp": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/PublicRsvpStateDto"
              }
            ]
          },
          "checkinPass": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/PublicCheckinPassDto"
              }
            ]
          }
        },
        "required": [
          "rsvp",
          "checkinPass"
        ]
      },
      "SubmitPublicRsvpEventSelectionDto": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "attending": {
            "type": "boolean"
          },
          "expectedAttendeeCount": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "eventId",
          "attending",
          "expectedAttendeeCount"
        ]
      },
      "SubmitPublicRsvpAttendeeDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "NAMED_INVITEE",
              "PLUS_ONE",
              "ADDITIONAL_CHILD"
            ]
          },
          "inviteeId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "quantity": {
            "type": "number",
            "minimum": 1
          }
        },
        "required": [
          "type",
          "quantity"
        ]
      },
      "SubmitPublicRsvpRequestDto": {
        "type": "object",
        "properties": {
          "expectedVersion": {
            "type": "number",
            "nullable": true,
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "ACCEPTED",
              "DECLINED"
            ]
          },
          "eventSelections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SubmitPublicRsvpEventSelectionDto"
            }
          },
          "attendees": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SubmitPublicRsvpAttendeeDto"
            }
          },
          "dietaryNotes": {
            "type": "string",
            "maxLength": 500,
            "nullable": true
          }
        },
        "required": [
          "expectedVersion",
          "status",
          "eventSelections",
          "attendees"
        ]
      },
      "PublicRsvpMutationResponseDto": {
        "type": "object",
        "properties": {
          "rsvp": {
            "$ref": "#/components/schemas/PublicRsvpStateDto"
          },
          "checkinPass": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/PublicCheckinPassDto"
              }
            ]
          }
        },
        "required": [
          "rsvp",
          "checkinPass"
        ]
      },
      "SubmitPublicGuestMessageRequestDto": {
        "type": "object",
        "properties": {
          "authorName": {
            "type": "string",
            "maxLength": 100,
            "nullable": true
          },
          "message": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "message"
        ]
      },
      "PublicGuestMessageDto": {
        "type": "object",
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "createdAt"
        ]
      },
      "PublicGuestMessageResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "$ref": "#/components/schemas/PublicGuestMessageDto"
          }
        },
        "required": [
          "message"
        ]
      }
    }
  }
}
